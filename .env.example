# Ganti dengan domain HTTPS utama saat deploy (tanpa slash di akhir).
APP_URL=https://www.rasoltek.com
APP_ENV=production
SEO_INDEXING=true
# Untuk staging/lokal: APP_ENV=local atau SEO_INDEXING=false.
PORTAL_URL=https://portal.rasoltek.com
REGISTER_URL=https://portal.rasoltek.com/register.php
DOMAIN_SEARCH_URL=https://portal.rasoltek.com/cart.php?a=add&domain=register

RDASH_API_BASE_URL=https://api.rdash.id/v1
RDASH_INCLUDE_PREMIUM_DOMAINS=false
RDASH_RESELLER_ID=isi_reseller_id_rdash
RDASH_API_KEY=isi_api_key_rdash
